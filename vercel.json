{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "empresas.revale.app"
        }
      ],
      "destination": "/empresas/"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "mi.revale.app"
        }
      ],
      "destination": "/empleados/"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "app.revale.app"
        }
      ],
      "destination": "/empleados/"
    },
    {
      "source": "/",
      "destination": "/comercios/"
    }
  ]
}
